#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -f "$root/bootloops/run_selftests.py" ]; then
    echo 'BootLoops is not installed. Run make toolkit and prepare its required dependencies.' >&2
    exit 4
fi
cd "$root/bootloops"
exec "$root/bootloops-python" run_selftests.py "$@"
