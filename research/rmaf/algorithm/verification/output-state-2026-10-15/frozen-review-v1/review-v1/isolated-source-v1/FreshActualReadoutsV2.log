OutputState.checked_materialization (S : Tree) (Q : List (List Nat)) (properS : (leaves S).Nodup)
  (hQ : partitionCheck (leaves S) Q = true) :
  (sourceForest S Q).length = Q.length ∧
    (List.map leaves (sourceForest S Q)).flatten.Perm Q.flatten ∧
      ∀ (s : Tree),
        s ∈ sourceForest S Q → ∃ U, U ∈ Q ∧ restrict U S = some s ∧ (leaves s).Perm U ∧ (leaves s).Nodup ∧ leaves s ≠ []
OutputState.sourceForest_proper (T S : Tree) (Q : List (List Nat)) (properT : (leaves T).Nodup)
  (properS : (leaves S).Nodup) (same : ∀ (x : Nat), x ∈ leaves T ↔ x ∈ leaves S)
  (hQ : partitionCheck (leaves S) Q = true) : proper (some T) (sourceForest S Q) = true
OutputState.exact_additional_cost (S : Tree) (Q F : List (List Nat)) (properS : (leaves S).Nodup)
  (hQ : partitionCheck (leaves S) Q = true) : additionalCost (sourceForest S Q) F = F.length - Q.length
OutputState.agrees_iff_original (T S : Tree) (Q F : List (List Nat)) (properT : (leaves T).Nodup)
  (properS : (leaves S).Nodup) (same : ∀ (x : Nat), x ∈ leaves T ↔ x ∈ leaves S)
  (hQ : partitionCheck (leaves S) Q = true) (sourceQ : pairwiseEmbeddings S Q = true) :
  agrees (some T) (sourceForest S Q) F = true ↔ agreement T S F = true ∧ Refines F Q
OutputState.generated_source_bridge (T S : Tree) (color : Nat → Nat) (q : Nat) (o : Universal233.CoreProgram.Output)
  (ho : o ∈ (Universal233.CoreProgram.generate S color q).outputs) (properT : (leaves T).Nodup)
  (properS : (leaves S).Nodup) (same : ∀ (x : Nat), x ∈ leaves T ↔ x ∈ leaves S) :
  proper (some T) (sourceForest S o.partition) = true ∧
    (sourceForest S o.partition).length = o.partition.length ∧
      (∀ (F : List (List Nat)),
          agrees (some T) (sourceForest S o.partition) F = true ↔ agreement T S F = true ∧ Refines F o.partition) ∧
        ∀ (F : List (List Nat)), additionalCost (sourceForest S o.partition) F = F.length - o.partition.length
OutputState.opposite_grouping (T S : Tree) (A B C D : List Nat) (aout o : Universal233.CoreProgram.Output) (q : Nat)
  (hs : (leaves S).Nodup) (ht : (leaves T).Nodup) (same : ∀ (x : Nat), x ∈ leaves T ↔ x ∈ leaves S)
  (hp : partitionCheck (leaves S) [A, B, C] = true) (ho : o ∈ Universal233.PairAssembly.sideOutputs S A B D q)
  (safe : Universal233.BinaryCheap.OppositeSafe S T A B C aout o) :
  ∃ a c,
    restrict A S = some a ∧
      restrict C S = some c ∧
        (leaves a).Perm A ∧
          (leaves c).Perm C ∧
            owned (sourceForest S o.partition) A = [a] ∧
              owned (sourceForest S o.partition) C = [c] ∧
                (sourceForest S o.partition).Perm ([a] ++ owned (sourceForest S o.partition) B ++ [c]) ∧
                  proper (some T) ([a] ++ owned (sourceForest S o.partition) B ++ [c]) = true ∧
                    PriorityClear (some T) a (owned (sourceForest S o.partition) B) [c]
OutputState.opposite_local_certificates (T S : Tree) (A B C : List Nat) (aout o : Universal233.CoreProgram.Output)
  (a c : Tree) (hs : (leaves S).Nodup) (ht : (leaves T).Nodup) (same : ∀ (x : Nat), x ∈ leaves T ↔ x ∈ leaves S)
  (hp : partitionCheck (leaves S) [A, B, C] = true) (safe : Universal233.BinaryCheap.OppositeSafe S T A B C aout o)
  (hra : restrict A S = some a) (hrc : restrict C S = some c) (goodC : restrictionAgrees S T C = true) :
  agrees (localTarget (some T) A) [a] aout.partition = true ∧
    additionalCost [a] aout.partition = 1 ∧ agrees (localTarget (some T) C) [c] [C] = true ∧ additionalCost [c] [C] = 0
OutputState.every_opposite_residual_query (solve : Option Tree → List Tree → Nat → Option (List (List Nat)))
  (T S : Tree) (A B C D : List Nat) (aout o : Universal233.CoreProgram.Output) (q0 q : Nat) (FB : List (List Nat))
  (hs : (leaves S).Nodup) (ht : (leaves T).Nodup) (same : ∀ (x : Nat), x ∈ leaves T ↔ x ∈ leaves S)
  (hp : partitionCheck (leaves S) [A, B, C] = true) (ho : o ∈ Universal233.PairAssembly.sideOutputs S A B D q0)
  (safe : Universal233.BinaryCheap.OppositeSafe S T A B C aout o) (goodC : restrictionAgrees S T C = true)
  (positive : 0 < q)
  (IH : ResidualSolverContract solve (localTarget (some T) B) (owned (sourceForest S o.partition) B) (q - 1))
  (query : solve (localTarget (some T) B) (owned (sourceForest S o.partition) B) (q - 1) = some FB) :
  have F := aout.partition ++ FB ++ [C];
  agrees (some T) (sourceForest S o.partition) F = true ∧
    agreement T S F = true ∧
      Refines F o.partition ∧
        additionalCost (sourceForest S o.partition) F = 1 + additionalCost (owned (sourceForest S o.partition) B) FB ∧
          additionalCost (sourceForest S o.partition) F ≤ q ∧ F.length - o.partition.length ≤ q
