singleton_cleanup_forward : ∀ (T : Option Tree) (ss : List Tree) (F : List (List Nat)) (a : Nat),
  agrees T ss F = true → Tree.leaf a ∈ ss → agrees (cleanupTarget T a) (cleanupSources ss a) (cleanupForest F a) = true
singleton_cleanup_reverse : ∀ (T : Option Tree) (ss : List Tree) (G : List (List Nat)) (a : Nat),
  proper T ss = true →
    Tree.leaf a ∈ ss → agrees (cleanupTarget T a) (cleanupSources ss a) G = true → agrees T ss ([a] :: G) = true
