-- One-shot safe suffix inventory; numeric autogenerated names are skipped.
import Lean
open Lean
#eval do
  let env ← importModules #[{module := `Ordinary}] {} (trustLevel := 0)
  env.constants.forM fun n _ => do
    match n with
    | .str _ "proper" => IO.println s!"ALLOWED_NAME {n}"
    | _ => pure ()
