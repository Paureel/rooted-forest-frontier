def RMAF.agreement : Tree → Tree → List (List Nat) → Bool :=
fun t u bs =>
  partitionCheck (leaves t) bs && partitionCheck (leaves u) bs && bs.all (restrictionAgrees t u) &&
      pairwiseEmbeddings t bs &&
    pairwiseEmbeddings u bs
def VertexGeometry.Refines : List (List Nat) → List (List Nat) → Prop :=
fun F Q => ∀ (P : List Nat), P ∈ F → ∃ R, R ∈ Q ∧ ∀ (x : Nat), x ∈ P → x ∈ R
def Universal233.CherryBranching.cuts : Tree → Nat → Nat → List Vertex :=
fun S a b => Universal233.HardParent.pendantOriginal S a b
def Universal233.CherryBranching.coreLabels : Tree → Nat → Nat → List Nat :=
fun S a b =>
  List.filter
    (fun x =>
      !(List.map (Universal233.HardParent.subtreeLabels S) (Universal233.CherryBranching.cuts S a b)).flatten.contains
          x)
    (leaves S)
def Universal233.CherryBranching.pendantPartition : Tree → Nat → Nat → List (List Nat) :=
fun S a b =>
  List.map (Universal233.HardParent.subtreeLabels S) (Universal233.CherryBranching.cuts S a b) ++
    [Universal233.CherryBranching.coreLabels S a b]
