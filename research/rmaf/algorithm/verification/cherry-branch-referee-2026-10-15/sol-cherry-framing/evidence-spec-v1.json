  "quotations": [
    {"id":"q01","source":"A1","start":3,"end":5,"text":"The complete faster algorithm, its global runtime, and its novelty remain OPEN."},
    {"id":"q02","source":"A1","start":20,"end":24,"text":"Strict refinement of every original F fails for t1."},
    {"id":"q03","source":"A1","start":36,"end":38,"text":"proves the stronger deterministic pendant rule stated in the retained baseline."},
    {"id":"q04","source":"A2","start":3,"end":6,"text":"No rho\nlabel or original cut-subset condition is assumed."},
    {"id":"q05","source":"A2","start":24,"end":24,"text":"Executable childCall; ExactBoundedChild IH per concrete child, including refusal/completeness and exact minimum guarantees"},
    {"id":"q06","source":"A2","start":34,"end":38,"text":"The local theorems do not supply solver."},
    {"id":"q07","source":"A2","start":40,"end":47,"text":"Invoke it once after choosing G; do not union display-edge lists from\nchildren."},
    {"id":"q08","source":"A2","start":49,"end":52,"text":"No local cherry claim is left open."},
    {"id":"q09","source":"A3","start":36,"end":36,"text":"| one `pendantPartition` | O(N^4) | Every subtreeLabels lookup, every leaf-list append, map/flatten allocation, root-complement masks with repeated flatten evaluation |"},
    {"id":"q10","source":"Q","start":5,"end":5,"text":"This does not establish a tight lower bound or refute a sharper O(N^4) analysis with a different argument."},
    {"id":"q11","source":"S1","start":3,"end":3,"text":"Complete recursion, special-priority completion, mutual termination, full recurrence/machine runtime, smaller base and novelty remain OPEN."},
    {"id":"q12","source":"S2","start":3,"end":3,"text":"Raw cherries/cuts/makeChild/remaining constructors do not perform general input validation"},
    {"id":"q13","source":"S1","start":50,"end":50,"text":"These numbers are declaration inventory, not scientific progress or percentages."},
    {"id":"q14","source":"L1","start":47,"end":53,"text":"∃ G, agreement T S G = true ∧ G.length ≤ F.length ∧ Refines G (pendantPartition S a b) := by"},
    {"id":"q15","source":"L2","start":8,"end":9,"text":"(leaves S).filter fun x => !((cuts S a b).map (subtreeLabels S)).flatten.contains x"},
    {"id":"q16","source":"L3","start":120,"end":121,"text":"if c.paid ≤ budget then some (budget-c.paid) else none"},
    {"id":"q17","source":"L5","start":138,"end":141,"text":"(∀ r, (∃ G, solver c r = some G) ↔ ChildWithin T S c r) ∧"},
    {"id":"q18","source":"L6","start":5,"end":6,"text":"[singletonChild S a,pendantChild S a b]"},
