import ForestResource
import BoundedFrontier
namespace GenericForest.LocalPolynomial
open RMAF ForestState Universal233 Universal233.CoreWork Universal233.CoreProgram Universal233.WholeSourceWork

/-- Explicit polynomial coefficients; M bounds target labels and current budget. -/
def inspectCap (M : Nat) := 4096*(7*M+1)^8
def resourceCap (M : Nat) := 2*M*(2*M+2)+2*M+1
def initialCap (M : Nat) := 128*(2*M+1)^3
def generateCap (M : Nat) := initialCap M+2*(cap (resourceCap M)+6)*(M+1)
def colorBound (M : Nat) := 16*(2*M+3)*(2*M)+4*(M+1)+3
def generationCap (M : Nat) := generateCap M+M*colorBound M
def spanBound (M : Nat) := ((16*(3*M+2)+16)*(2*M+1))*(2*M)
def overlapCap (M : Nat) := (2*M)*(2*M)*(2*spanBound M+16*(2*M+1)^3)
def materialCap (M : Nat) := 2*inspectCap M+256*(M+2*M*M+2*M+1)^4
def overheadPolynomial (M : Nat) :=
 14*inspectCap M+overlapCap M+2*generationCap M+12*materialCap M+32*(2*M+1)

theorem nat_sum_le_constant {α : Type} (L : List α) (f : α → Nat) (B : Nat)
 (bound : ∀x,x∈L → f x≤B) : (L.map f).sum≤L.length*B := by
 induction L with
 | nil => simp
 | cons x L ih =>
  have one:=bound x (by simp)
  have tail:=ih (fun y hy=>bound y (by simp [hy]))
  simp only [List.map_cons,List.sum_cons,List.length_cons,Nat.add_mul,Nat.one_mul]
  omega

theorem nat_member_le_sum {α : Type} (L : List α) (f : α → Nat) (a : α) (mem : a∈L) : f a≤(L.map f).sum := by
 induction L with
 | nil => simp at mem
 | cons x L ih =>
  simp only [List.mem_cons] at mem
  rcases mem with rfl|mem
  · simp only [List.map_cons,List.sum_cons];omega
  · have h:=ih mem;simp only [List.map_cons,List.sum_cons];omega

theorem state_size_bounds (T : Option Tree) (ss : List Tree) (hp : proper T ss=true) (M : Nat)
 (size : (labels T).length≤M) : targetNodes T≤2*M ∧ sourceNodes ss≤2*M ∧ ss.length≤2*M := by
 have volume:=proper_source_size T ss hp
 have target : targetNodes T≤2*M := by
  cases T with
  | none => simp [targetNodes]
  | some t => have h:=treeNodes_le_twice_leaves t;simp only [targetNodes,labels] at *;omega
 exact ⟨target,by omega,by omega⟩

theorem source_size_bounds (T : Option Tree) (ss : List Tree) (hp : proper T ss=true) (M : Nat)
 (size : (labels T).length≤M) (s : Tree) (mem : s∈ss) : treeNodes s≤2*M ∧ (leaves s).length≤M := by
 have volumes:=state_size_bounds T ss hp M size
 have node:=nat_member_le_sum ss treeNodes s mem
 change treeNodes s≤sourceNodes ss at node
 have perm:=RestrictionBridge.checked_flatten_perm (labels T) (ss.map leaves) (proper_parts T ss hp).1 (proper_parts T ss hp).2
 have leaf:=nat_member_le_sum ss (fun s=> (leaves s).length) s mem
 have eq : (ss.map fun s=>(leaves s).length).sum=(labels T).length := by
  rw [←perm.length_eq]
  induction ss with
  | nil => rfl
  | cons s ss ih => simpa only [List.map_cons,List.flatten_cons,List.length_append,List.sum_cons] using congrArg (fun n=>(leaves s).length+n) ih
 exact ⟨Nat.le_trans node volumes.2.1,by omega⟩

theorem inspection_bound (T : Option Tree) (ss : List Tree) (q M : Nat)
 (hp : proper T ss=true) (size : (labels T).length≤M) (budget : q≤M) : inspectionBill T ss q≤inspectCap M := by
 obtain ⟨ht,hs,hn⟩:=state_size_bounds T ss hp M size
 have h : targetNodes T+sourceNodes ss+ss.length+q+1≤7*M+1:=by omega
 exact Nat.mul_le_mul_left 4096 (Nat.pow_le_pow_left h 8)

theorem resource_bound (s : Tree) (M : Nat) (nodes : treeNodes s≤2*M) : inputResource s≤resourceCap M := by
 have h:=Nat.mul_le_mul nodes (Nat.add_le_add_right nodes 2)
 simp only [inputResource,resourceCap];omega

theorem generate_prefix_bound (s : Tree) (color : Nat → Nat) (q M : Nat)
 (nodes : treeNodes s≤2*M) (budget : q≤M) : (meterGenerate s color q).measured.work≤generateCap M*2^q := by
 have init : initialCharge s≤initialCap M:=Nat.mul_le_mul_left 128 (Nat.pow_le_pow_left (Nat.add_le_add_right nodes 1) 3)
 have rc:=resource_bound s M nodes
 have caple : cap (inputResource s)≤cap (resourceCap M):=Nat.mul_le_mul_left 256 (Nat.pow_le_pow_left (Nat.add_le_add_right rc 1) 3)
 have m : min q ((leaves s).length-1)≤q:=Nat.min_le_left _ _
 have exponent : 2^(min q ((leaves s).length-1)+1)≤2*2^q := by
  have h:=Nat.pow_le_pow_right (n:=2) (by decide) (Nat.add_le_add_right m 1)
  simpa only [Nat.pow_succ,Nat.mul_comm] using h
 have coeff : (cap (inputResource s)+6)*(min q ((leaves s).length-1)+1)≤(cap (resourceCap M)+6)*(M+1):=
  Nat.mul_le_mul (Nat.add_le_add_right caple 6) (by omega)
 have product:=Nat.mul_le_mul coeff exponent
 have pow : 1≤2^q:=Nat.pow_pos (by decide)
 have initial:=Nat.mul_le_mul_left (initialCap M) pow
 simp only [Nat.mul_one] at initial
 have actual:=generate_work_bound s color q
 unfold generateCap
 have algebra : ((cap (resourceCap M)+6)*(M+1))*(2*2^q)=
  (2*(cap (resourceCap M)+6)*(M+1))*2^q := by ac_rfl
 rw [algebra] at product
 simp only [Nat.add_mul]
 omega
end GenericForest.LocalPolynomial
