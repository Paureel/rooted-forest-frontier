import LocalBill
namespace GenericForest.LocalPolynomial
open RMAF ForestState Universal233 Universal233.CoreWork

private theorem lift_power (M a b C : Nat) (hM : 2≤M) (ab : a≤b) : C*M^a≤C*M^b :=
 Nat.mul_le_mul_left C (Nat.pow_le_pow_right (by omega) ab)

private theorem basic_square (M : Nat) (hM : 2≤M) : 1≤M^2 ∧ M≤M^2 := by
 have p : 1≤M:=by omega
 have h:=Nat.mul_le_mul_left M p
 simpa only [Nat.mul_one,Nat.pow_two] using And.intro (show 1≤M*M from by omega) h

private theorem inspection_monomial (M : Nat) (hM : 2≤M) : inspectCap M≤(4096*8^8)*M^8 := by
 have h:=Nat.mul_le_mul_left 4096 (Nat.pow_le_pow_left (show 7*M+1≤8*M by omega) 8)
 simpa only [inspectCap,Nat.mul_pow,Nat.mul_assoc] using h

private theorem resource_monomial (M : Nat) (hM : 2≤M) : resourceCap M+1≤32*M^2 := by
 have sq:=basic_square M hM
 unfold resourceCap
 simp only [Nat.mul_add,Nat.add_mul,Nat.mul_assoc,Nat.mul_left_comm M 2,Nat.pow_two] at sq ⊢
 omega

private theorem core_cap_monomial (M : Nat) (hM : 2≤M) : cap (resourceCap M)+6≤(256*32^3+6)*M^6 := by
 have h:=Nat.mul_le_mul_left 256 (Nat.pow_le_pow_left (resource_monomial M hM) 3)
 have pos : 1≤M^6:=Nat.pow_pos (by omega)
 have extra:=Nat.mul_le_mul_left 6 pos
 unfold cap at *
 simp only [Nat.mul_pow,←Nat.pow_mul,Nat.mul_assoc] at h
 change 256*(resourceCap M+1)^3≤(256*32^3)*M^6 at h
 simp only [Nat.add_mul]
 omega

private theorem initial_monomial (M : Nat) (hM : 2≤M) : initialCap M≤(128*3^3)*M^3 := by
 have h:=Nat.mul_le_mul_left 128 (Nat.pow_le_pow_left (show 2*M+1≤3*M by omega) 3)
 simpa only [initialCap,Nat.mul_pow,Nat.mul_assoc] using h

private theorem color_monomial (M : Nat) (hM : 2≤M) : colorBound M≤256*M^2 := by
 have sq:=basic_square M hM
 have h:=Nat.mul_le_mul (Nat.mul_le_mul_left 16 (show 2*M+3≤4*M by omega)) (Nat.le_refl (2*M))
 unfold colorBound
 simp only [Nat.mul_assoc,Nat.mul_left_comm M 2,Nat.pow_two] at sq h ⊢
 omega

private theorem generation_monomial (M : Nat) (hM : 2≤M) :
 generationCap M≤(128*3^3+4*(256*32^3+6)+256)*M^8 := by
 have initial:=initial_monomial M hM
 have core:=core_cap_monomial M hM
 have p:=Nat.mul_le_mul (Nat.mul_le_mul_left 2 core) (show M+1≤2*M by omega)
 have eq : (2*((256*32^3+6)*M^6))*(2*M)=(4*(256*32^3+6))*M^7 := by
  rw [show M^7=M^6*M from Nat.pow_succ _ _]
  calc
   _ = ((2*2)*(256*32^3+6))*(M^6*M) := by ac_rfl
   _ = _ := rfl
 rw [eq] at p
 have col:=Nat.mul_le_mul_left M (color_monomial M hM)
 have eqc : M*(256*M^2)=256*M^3 := by rw [show M^3=M^2*M from Nat.pow_succ _ _];ac_rfl
 rw [eqc] at col
 have ilift:=lift_power M 3 8 (128*3^3) hM (by decide)
 have clift:=lift_power M 3 8 256 hM (by decide)
 have plift:=lift_power M 7 8 (4*(256*32^3+6)) hM (by decide)
 unfold generationCap generateCap
 simp only [Nat.add_mul]
 omega

private theorem span_monomial (M : Nat) (hM : 2≤M) : spanBound M≤768*M^3 := by
 have a : 16*(3*M+2)+16≤128*M:=by omega
 have b : 2*M+1≤3*M:=by omega
 have h:=Nat.mul_le_mul (Nat.mul_le_mul a b) (Nat.le_refl (2*M))
 have eq : ((128*M)*(3*M))*(2*M)=768*M^3 := by simp only [Nat.pow_succ,Nat.pow_zero,Nat.one_mul];ac_rfl
 rw [eq] at h
 exact h

private theorem overlap_monomial (M : Nat) (hM : 2≤M) : overlapCap M≤(4*(2*768+16*3^3))*M^8 := by
 have span:=span_monomial M hM
 have extra:=Nat.mul_le_mul_left 16 (Nat.pow_le_pow_left (show 2*M+1≤3*M by omega) 3)
 simp only [Nat.mul_pow,Nat.mul_assoc] at extra
 have middle : 2*spanBound M+16*(2*M+1)^3≤(2*768+16*3^3)*M^3 := by
  simp only [Nat.add_mul];omega
 have h:=Nat.mul_le_mul_left ((2*M)*(2*M)) middle
 have eq : ((2*M)*(2*M))*((2*768+16*3^3)*M^3)=(4*(2*768+16*3^3))*M^5 := by
  rw [show M^5=M^3*M*M from by simp only [Nat.pow_succ]]
  calc
   _ = ((2*2)*(2*768+16*3^3))*((M^3*M)*M) := by ac_rfl
   _ = _ := rfl
 rw [eq] at h
 exact Nat.le_trans h (lift_power M 5 8 _ hM (by decide))

private theorem material_monomial (M : Nat) (hM : 2≤M) : materialCap M≤(2*(4096*8^8)+256*6^4)*M^8 := by
 have sq:=basic_square M hM
 have inside : M+2*M*M+2*M+1≤6*M^2 := by simp only [Nat.pow_two,Nat.mul_assoc] at sq ⊢;omega
 have out:=Nat.mul_le_mul_left 256 (Nat.pow_le_pow_left inside 4)
 simp only [Nat.mul_pow,←Nat.pow_mul,Nat.mul_assoc] at out
 change 256*(M+2*M*M+2*M+1)^4≤(256*6^4)*M^8 at out
 have inspection:=inspection_monomial M hM
 have twice:=Nat.mul_le_mul_left 2 inspection
 unfold materialCap
 simp only [Nat.add_mul,Nat.mul_assoc] at twice ⊢
 omega

/-- Deliberately loose, explicit monomial for the complete local source bill. -/
theorem overheadPolynomial_monomial (M : Nat) (hM : 2≤M) : overheadPolynomial M≤2^50*M^8 := by
 have inspection:=Nat.mul_le_mul_left 14 (inspection_monomial M hM)
 have overlap:=overlap_monomial M hM
 have generation:=Nat.mul_le_mul_left 2 (generation_monomial M hM)
 have material:=Nat.mul_le_mul_left 12 (material_monomial M hM)
 have linear : 32*(2*M+1)≤96*M:=by omega
 have lift:=lift_power M 1 8 96 hM (by decide)
 simp only [Nat.pow_one] at lift
 let C : Nat:=14*(4096*8^8)+4*(2*768+16*3^3)+2*(128*3^3+4*(256*32^3+6)+256)+12*(2*(4096*8^8)+256*6^4)+96
 have sum : overheadPolynomial M≤C*M^8 := by
  unfold overheadPolynomial C
  simp only [Nat.add_mul,Nat.mul_assoc] at inspection generation material ⊢
  omega
 have coefficient : C≤2^50:=by decide
 exact Nat.le_trans sum (Nat.mul_le_mul_right (M^8) coefficient)

/-- Fully printed monomial local coefficient; no ordinary charge is included. -/
theorem monomial_local_overhead (ordinary : FrontierWork.Ordinary) (T : Option Tree) (N Q : Nat)
 (c : Rat) (hc : 2≤c) (size : (labels T).length≤N) :
 FrontierWork.LocalOverheadBound ordinary T Q c ((2^50*(N+Q+2)^8:Nat):Rat) := by
 have small:=polynomial_local_overhead ordinary T N Q c hc size
 intro ss q budget proper
 have h:=small ss q budget proper
 have coeff:=Rat.natCast_le_natCast.2 (overheadPolynomial_monomial (N+Q+2) (by omega))
 have cp : 0<c:=by grind
 exact Rat.le_trans h (Rat.mul_le_mul_of_nonneg_right coeff (Rat.le_of_lt (Rat.pow_pos cp)))

theorem source_work_monomial_size_capped (ordinary : FrontierWork.Ordinary) (W : FrontierWork.OrdinaryWork)
 (T : Option Tree) (N Q : Nat) (c D : Rat) (hc : 2<c) (hD : 0≤D) (size : (labels T).length≤N)
 (bill : FrontierSize.SizeCappedOrdinaryBillBound W N Q c D) (ss : List Tree) (q : Nat) (hq : q≤Q) (hp : proper T ss=true) :
 sourceWork ordinary W T ss q≤(D+FrontierWork.geometric c*(((2^50*(N+Q+2)^8:Nat):Rat)))*c^q :=
 FrontierSize.source_work_bound_size_capped ordinary W T N Q c _ D hc Rat.natCast_nonneg hD
  (monomial_local_overhead ordinary T N Q c (Rat.le_of_lt hc) size) bill ss q hq hp size
end GenericForest.LocalPolynomial
