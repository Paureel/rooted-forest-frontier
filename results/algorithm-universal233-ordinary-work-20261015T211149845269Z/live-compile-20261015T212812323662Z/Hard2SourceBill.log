bill : BelowWorkBill W (leaves T).length q Rule5ActualTrace.base D
xs : List Query := ⋯
point : ∀ (pb : Query), pb ∈ xs → ↑(W pb.fst.fst pb.fst.snd pb.snd) ≤ D * Rule5ActualTrace.base ^ pb.snd
power :
  frontierPower Rule5ActualTrace.base xs =
