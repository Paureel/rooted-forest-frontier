T S : Tree
c d : Candidate
q : Nat
proper0 : DepthOne.proper T S = true
forward : CherryBranching.select T S = some (Priority.hard2, c)
reverse : CherryBranching.select S T = some (Priority.hard2, d)
noT : Rule4.select T S = none
noS : Rule4.select S T = none
D : Rat
positive : 0 ≤ D
bill : BelowWorkBill W (leaves T).length q Rule5ActualTrace.base D
xs : List Query := ⋯
point : ∀ (pb : Query), pb ∈ xs → ↑(W pb.fst.fst pb.fst.snd pb.snd) ≤ D * Rule5ActualTrace.base ^ pb.snd
power :
  frontierPower Rule5ActualTrace.base xs =
    Rule5ActualTrace.base ^ q * actualQueryMass Rule5ActualTrace.base q (List.map Prod.snd xs)
sum :
  (List.map (fun pb => ↑(W pb.fst.fst pb.fst.snd pb.snd)) xs).sum ≤
    D * (Rule5ActualTrace.base ^ q * actualQueryMass Rule5ActualTrace.base q (List.map Prod.snd xs))
mass :
  Rule5ActualTrace.mass Rule5ActualTrace.base q (hard2Trace actual T S c d q).queries ≤
    Rule5ActualTrace.gamma Rule5ActualTrace.base
