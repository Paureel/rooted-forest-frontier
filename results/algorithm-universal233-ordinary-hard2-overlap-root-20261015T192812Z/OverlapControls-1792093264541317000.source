import PairGuards
import OverlapPrecontrols
import FinalControls
namespace Universal233.Hard2Overlap.Controls
open RMAF VertexGeometry CoreGraph CutRealization HardParent CherryBranching Rule5Local Rule5Local.Pre PaidAssembly
set_option maxRecDepth 10000
def firstCommon : Candidate := ⟨[false,false,false,false,true],3,4,
 [[false,false,true,false,false,true],[false,false,true,false,true]]⟩
theorem disjoint_selected : Hard2Overlap.select t4 [0,1] [2] [3]=some .disjoint := by decide
theorem clique_selected : Hard2Overlap.select t6 [0,3] [1,4] [2,5]=some (.clique []) := by decide
theorem diagonal_selected : Hard2Overlap.select t6 [0,1] [2,5] [3,4]=some (.diagonal .abc [false] [true]) := by decide
theorem middle_first_selected : Hard2Overlap.select t6 [2,5] [0,1] [3,4]=some (.diagonal .bac [false] [true]) := by decide
theorem middle_third_selected : Hard2Overlap.select t6 [0,1] [3,4] [2,5]=some (.diagonal .acb [false] [true]) := by decide
theorem four_selected : Hard2Overlap.select t7 [0,1] [2,5,6] [3,4]=some (.four .abc [false] [true]) := by decide
theorem pair_selected : Hard2Overlap.select t5 [0,2] [1,3] [4]=some (.pair .abc (.edge ([false],[false,false]))) := by decide
theorem pair_ac_selected : Hard2Overlap.select t5 [0,2] [4] [1,3]=some (.pair .acb (.edge ([false],[false,false]))) := by decide
theorem pair_bc_selected : Hard2Overlap.select t5 [4] [0,2] [1,3]=some (.pair .bca (.edge ([false],[false,false]))) := by decide
theorem actual_first_still_hard2 : CherryBranching.select commonT commonS=some (.hard2,firstCommon) := by decide
theorem actual_first_overlap_selected : runHard2 commonT commonS firstCommon=some (.pair .acb (.vertex [false,false,false])) := by decide
theorem actual_pair_both_bad :
 restrictionAgrees commonT commonS (leftParent commonS [false,false,true,false,false,true])=false ∧
 restrictionAgrees commonT commonS (rootParent commonS [false,false,true,false,false,true] [false,false,true,false,true])=false := by decide
theorem disjoint_good_count_retained :
 ([[0,1],[2],[3]].filter (fun B=>restrictionAgrees t4 t4 B)).length=3 := by decide
#check actual_hard2_exhaustive
#check actual_disjoint_admission_iff
#check actual_clique_paid
#check actual_four_paid
#check actual_diagonal_paid
#check selected_pair_guards
end Universal233.Hard2Overlap.Controls
