import CheckControls
open RMAF ForestState Universal233 WholeSourceWork GenericForest GenericForest.CheckCorrespondence GenericForest.CheckCorrespondence.Controls
example : (meterCount 0 [0,0,0]).work=0 := by decide
example : (meterChecked (some leaf) [leaf] 0 [[0],[0]]).value=some [[0],[0]] := by decide
example : (meterProper (some leaf) []).value=true := by decide
example : minimalVertices [0,2] unaryTree=[[],[false,false],[true]] := by decide
example : ([[[0]],[[0]]] : List Forest).length=1 := by decide
example : (meterChecked (some leaf) [leaf] 0 [[1]]).value=some [[1]] := by decide
