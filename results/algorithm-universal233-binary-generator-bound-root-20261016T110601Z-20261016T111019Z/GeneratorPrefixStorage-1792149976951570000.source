import GeneratorStorage
namespace GenericForest.BinaryProducer.Generator
open BinaryProvider GenericForest.ScalarBits Universal233.WholeSourceWork Universal233.CoreWork

def treeCells : GTree→Nat
 | .leaf g=>7+g.origin.length+blockCells g.labels
 | .node p l r=>4+p.length+treeCells l+treeCells r

def stateCells (T : GTree) (d : List Group) (c : Addresses) :=
 8+treeCells T+(d.map (fun g=>7+g.origin.length+blockCells g.labels)).sum+addressCells c

def Stored (W M q : Nat) (T : GTree) (d : List Group) (c : Addresses) : Prop :=
 StateGood W M q T d c ∧ ∀g∈d,g.origin.length≤M

def stateCellCap (W M : Nat) := 8+(W+10)*M+M*(7+M+M*(W+1))+M*(M+1)

theorem treeCells_cap (W : Nat) (T : GTree) (w : Wide W T) : treeCells T≤(W+10)*size T := by
 induction T with
 | leaf g=>
  have a:=blockCells_cap W g.labels w
  have labels:=Nat.mul_le_mul_left g.labels.length (show W+1≤W+10 by omega)
  have origin:=Nat.mul_le_mul_right g.origin.length (show 1≤W+10 by omega)
  simp only [Nat.one_mul] at origin
  simp only [treeCells,size,Nat.mul_add,Nat.mul_one]
  rw [Nat.mul_comm g.labels.length (W+1)] at a
  rw [Nat.mul_comm g.labels.length (W+10)] at labels
  omega
 | node p l r ihl ihr=>
  have a:=ihl w.1;have b:=ihr w.2
  have origin:=Nat.mul_le_mul_right p.length (show 1≤W+10 by omega)
  simp only [Nat.one_mul] at origin
  simp only [treeCells,size,Nat.mul_add,Nat.mul_one];omega

theorem stateCells_cap (W M q T d c) (h : Stored W M q T d c) : stateCells T d c≤stateCellCap W M := by
 have within:=h.1.1;unfold Within at within
 have t:=Nat.le_trans (treeCells_cap W T h.1.2.1) (Nat.mul_le_mul_left (W+10) (by omega : size T≤M))
 have ds:=GenericForest.LocalPolynomial.nat_sum_le_constant d (fun g=>7+g.origin.length+blockCells g.labels) (7+M+M*(W+1))
  (fun g hg=>by have a:=h.1.2.2.1 g hg;have b:=blockCells_cap W g.labels a.1;have z:=Nat.mul_le_mul_right (W+1) a.2;have o:=h.2 g hg;omega)
 have dm:=Nat.mul_le_mul_right (7+M+M*(W+1)) (by omega : d.length≤M)
 have cs:=GenericForest.LocalPolynomial.nat_sum_le_constant c (fun v=>1+v.length) (M+1) (fun v hv=>by have a:=h.1.2.2.2 v hv;omega)
 have cm:=Nat.mul_le_mul_right (M+1) (by omega : c.length≤M)
 unfold stateCells stateCellCap addressCells;omega

theorem stored_normalized (W M q T d c) (h : Stored W M q T d c) : Stored W M q (normalizeBits T).value d c :=
 ⟨state_normalized W M q T d c h.1,h.2⟩

theorem stored_child (W M q T d c g U) (h : Stored W M (q+1) T d c)
 (gm : g∈(groupsBits T).value) (he : (eraseBits g.origin T).value=some U) :
 Stored W M q U (g::d) (g.origin::c) := by
 have a:=group_size T g gm;have w:=h.1.1;unfold Within at w
 refine ⟨state_child W M q T d c g U h.1 gm he,?_⟩
 intro x hx;rcases List.mem_cons.mp hx with rfl|hx
 · omega
 · exact h.2 x hx

/-- Read-only source retention instrument. It follows exactly the root,
duplicate and erase guards, including every failed and pruned attempt. -/
def descendantVolume (p : GTree→List Group→Addresses→Nat) (T : GTree) (d : List Group) (c : Addresses) (g : Group) : Nat :=
 if (meterAddressEq g.origin []).value then 0 else
 if (meterVertexContains g.origin c).value then 0 else
 match (eraseBits g.origin T).value with
 | none=>0 | some U=>p U (g::d) (g.origin::c)

def prunedVolume (T : GTree) (d : List Group) (c : Addresses) := stateCells T d c+17

def prefixVolume : Capacity→GTree→List Group→Addresses→Nat
 | fuel,T,d,c=>
  let n:=(normalizeBits T).value
  let r:=runBits fuel T d c
  let localCells:=stateCells T d c+stateCells n d c+r.work+receiptCells r.value
  let p:=match fuel with | []=>prunedVolume | _::fs=>prefixVolume fs
  match (chooseBits n).value with
  | .finish=>localCells | .refuse _=>localCells
  | .one g=>localCells+descendantVolume p n d c g
  | .two a b=>localCells+descendantVolume p n d c a+descendantVolume p n d c b

/-- This ledger retains every reached prefix state and completed receipt,
expands shared payloads, and additionally reserves all charged provider work
at each prefix. It is an explicit conservative source model, not native heap. -/
def retentionCoefficient (W M : Nat) := 4*stateCellCap W M+34+
 32*(runCoefficient W M+6)*(M+1)+3*(outputCellCap W M+2)+3*(3*M+4)+8

theorem descendantVolume_bound (W M q C : Nat) (p : GTree→List Group→Addresses→Nat)
 (T d c g) (h : Stored W M (q+1) T d c) (gm : g∈(groupsBits T).value)
 (hp : ∀U d c,Stored W M q U d c→p U d c≤C) : descendantVolume p T d c g≤C := by
 dsimp only [descendantVolume];split
 · exact Nat.zero_le _
 · split
   · exact Nat.zero_le _
   · cases he : (eraseBits g.origin T).value with
     | none=>exact Nat.zero_le _
     | some U=>exact hp _ _ _ (stored_child W M q T d c g U h gm he)

theorem prefixVolume_bound (W M : Nat) (fuel : Capacity) (T d c) (h : Stored W M (fuel.length+1) T d c) :
 prefixVolume fuel T d c≤retentionCoefficient W M*(fuel.length+1)*2^(fuel.length+1) := by
 induction fuel generalizing T d c with
 | nil=>
  have cur:=stateCells_cap W M 1 T d c h
  have norm:=stored_normalized W M 1 T d c h
  have nc:=stateCells_cap W M 1 _ d c norm
  have rw:=runBits_polynomial_exponential W M [] T d c h.1
  have rs:=runBits_returned_storage W M [] T d c h.1
  have pc : ∀U d c,Stored W M 0 U d c→prunedVolume U d c≤stateCellCap W M+17:=by
   intro U d c hs;have z:=stateCells_cap W M 0 U d c hs;unfold prunedVolume;omega
  have chosen:=chooseBits_mem (normalizeBits T).value
  have child (g : Group) (gm : g∈(groupsBits (normalizeBits T).value).value) :=
   descendantVolume_bound W M 0 (stateCellCap W M+17) prunedVolume _ d c g norm gm pc
  dsimp only [prefixVolume]
  cases he : (chooseBits (normalizeBits T).value).value with
  | finish=>simp only;unfold retentionCoefficient;simp only [List.length_nil,Nat.zero_add,Nat.mul_one,Nat.pow_one] at rw rs ⊢;omega
  | refuse why=>simp only;unfold retentionCoefficient;simp only [List.length_nil,Nat.zero_add,Nat.mul_one,Nat.pow_one] at rw rs ⊢;omega
  | one g=>
   have a:=child g (chosen.1 g he)
   simp only;unfold retentionCoefficient;simp only [List.length_nil,Nat.zero_add,Nat.mul_one,Nat.pow_one] at rw rs ⊢;omega
  | two a b=>
   have mem:=chosen.2 a b he
   have x:=child a mem.1;have y:=child b mem.2
   simp only;unfold retentionCoefficient;simp only [List.length_nil,Nat.zero_add,Nat.mul_one,Nat.pow_one] at rw rs ⊢;omega
 | cons u fuel ih=>
  have st:=h.1.1;unfold Within at st;simp only [List.length_cons] at st
  have fm : fuel.length+1≤M:=by omega
  have pow : 1≤2^(fuel.length+2):=Nat.one_le_pow _ _ (by decide)
  have cur:=stateCells_cap W M (fuel.length+2) T d c h
  have norm:=stored_normalized W M (fuel.length+2) T d c h
  have nc:=stateCells_cap W M (fuel.length+2) _ d c norm
  have rw:=runBits_polynomial_exponential W M (u::fuel) T d c h.1
  have rs:=runBits_returned_storage W M (u::fuel) T d c h.1
  have rm:=Nat.mul_le_mul_right (2^(fuel.length+2)) (Nat.mul_le_mul_left (32*(runCoefficient W M+6)) (show (u::fuel).length+1≤M+1 by simp only [List.length_cons];omega))
  have fixed:=Nat.mul_le_mul_left (2*stateCellCap W M+3*(3*M+4)+8) pow
  simp only [Nat.mul_one] at fixed
  have chosen:=chooseBits_mem (normalizeBits T).value
  have child (g : Group) (gm : g∈(groupsBits (normalizeBits T).value).value) :=
   descendantVolume_bound W M (fuel.length+1) (retentionCoefficient W M*(fuel.length+1)*2^(fuel.length+1)) (prefixVolume fuel)
    _ d c g norm gm ih
  have eq : retentionCoefficient W M*(fuel.length+1+1)*2^(fuel.length+1+1)=
   2*(retentionCoefficient W M*(fuel.length+1)*2^(fuel.length+1))+retentionCoefficient W M*2^(fuel.length+2):=by
   simp only [Nat.pow_succ,Nat.mul_add,Nat.add_mul,Nat.mul_one];ac_rfl
  simp only [List.length_cons]
  rw [eq]
  dsimp only [prefixVolume]
  cases he : (chooseBits (normalizeBits T).value).value with
  | finish=>simp only;unfold retentionCoefficient;simp only [List.length_cons,Nat.add_assoc,Nat.add_mul] at rw rs rm fixed ⊢;omega
  | refuse why=>simp only;unfold retentionCoefficient;simp only [List.length_cons,Nat.add_assoc,Nat.add_mul] at rw rs rm fixed ⊢;omega
  | one g=>
   have a:=child g (chosen.1 g he)
   simp only;unfold retentionCoefficient at a ⊢;simp only [List.length_cons,Nat.add_assoc,Nat.add_mul] at rw rs rm fixed ⊢;omega
  | two a b=>
   have mem:=chosen.2 a b he
   have x:=child a mem.1;have y:=child b mem.2
   simp only;unfold retentionCoefficient at x y ⊢;simp only [List.length_cons,Nat.add_assoc,Nat.add_mul] at rw rs rm fixed ⊢;omega
end GenericForest.BinaryProducer.Generator
