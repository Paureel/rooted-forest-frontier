import PersistentEmbeddings
namespace GenericForest.BinaryProvider
open Universal233.WholeSourceWork GenericForest.ScalarBits GenericForest.CheckCorrespondence

def TargetWidth (W : Nat) (T : Option Tree):=∀t∈T,TreeWidth W t

theorem sourceLeavesCopy_width (W : Nat) (ss : List Tree) (sc : SourcesWidth W ss) :
 ForestWidth W (sourceLeavesCopy ss).value := by
 intro B hB
 rw [sourceLeavesCopy_value] at hB
 obtain ⟨s,hs,rfl⟩:=List.mem_map.mp hB
 exact sc s hs
theorem targetLabelsCopy_width (W : Nat) (T : Option Tree) (tc : TargetWidth W T) :
 BlockWidth W (targetLabelsCopy T).value := by
 cases T with
 | none=>intro x hx;simp [targetLabelsCopy] at hx
 | some t=>simpa only [targetLabelsCopy,leavesCopy_value,TreeWidth] using tc t (by simp)

def properLabels (C : Capacity) (T : Option Tree) (ss : List Tree) : Charged Bool:=
 let a:=targetLabelsCopy T;let b:=nodupLabels a.value;let c:=sourceLeavesCopy ss
 let d:=partitionLabels C a.value c.value
 ⟨b.value&&d.value,a.work+b.work+c.work+d.work+4⟩
theorem properLabels_projects (W : Nat) (C : Capacity) (T : Option Tree) (ss : List Tree)
 (cw : C.length≤W) (cp : 0<C.length) (tc : TargetWidth W T) (sc : SourcesWidth W ss)
 (fits : (sourceLeavesCopy ss).value.flatten.length<2^C.length) :
 Projects W id (properLabels C T ss) (meterProper (targetValue T) (sourcesValue ss)) := by
 have a:=targetLabelsCopy_projects W T tc
 have b:=nodupLabels_projects W (targetLabelsCopy T).value (targetLabelsCopy_width W T tc)
 have c:=sourceLeavesCopy_projects W ss sc
 have d:=partitionLabels_projects W C (targetLabelsCopy T).value (sourceLeavesCopy ss).value cw cp
  (targetLabelsCopy_width W T tc) (sourceLeavesCopy_width W ss sc) fits
 have p:=beta_positive W
 simp only [Projects,id_eq] at a b c d ⊢
 simp only [properLabels,meterProper,←a.1,←c.1,b.1,d.1]
 constructor
 · trivial
 · simp only [Nat.mul_add];omega

def targetAgreesLabels : Option Tree→Tree→Block→Charged Bool
 | none,_,_=>⟨false,1⟩ | some t,s,B=>restrictionAgreesLabels t s B
theorem targetAgreesLabels_projects (W : Nat) (T : Option Tree) (s : Tree) (B : Block)
 (tc : TargetWidth W T) (sc : TreeWidth W s) (bc : BlockWidth W B) :
 Projects W id (targetAgreesLabels T s B) (meterTargetAgrees (targetValue T) (treeValue s) (blockValue B)) := by
 cases T with
 | none=>simp [Projects,targetAgreesLabels,targetValue,meterTargetAgrees];exact beta_positive W
 | some t=>exact restrictionAgreesLabels_projects W t s B (tc t (by simp)) sc bc

def targetEmbeddingsLabels : Option Tree→Forest→Charged Bool
 | none,F=>⟨F.isEmpty,1⟩ | some t,F=>pairwiseLabels t F
theorem targetEmbeddingsLabels_projects (W : Nat) (T : Option Tree) (F : Forest)
 (tc : TargetWidth W T) (fc : ForestWidth W F) :
 Projects W id (targetEmbeddingsLabels T F) (meterTargetEmbeddings (targetValue T) (forestValue F)) := by
 cases T with
 | none=>simp only [Projects,id_eq,targetEmbeddingsLabels,targetValue,Option.map_none,meterTargetEmbeddings]
         constructor
         · unfold forestValue
           exact (List.isEmpty_map (l:=F) (f:=blockValue)).symm
         · exact beta_positive W
 | some t=>exact pairwiseLabels_projects W t F (tc t (by simp)) fc

end GenericForest.BinaryProvider
