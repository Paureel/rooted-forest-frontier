import ScalarControls
open RMAF ForestState Universal233 WholeSourceWork GenericForest.CheckCorrespondence GenericForest.ScalarBits GenericForest.ScalarBits.Controls
set_option maxRecDepth 20000
example : (equalBits [true] [true,false,false]).value=false := by decide +kernel
example : decode (addBits [true,true,true,true,true] [true]).value=0 := by decide +kernel
example : decode (subtractBits [true] [false,false,false,false,false,true]).value=31 := by decide +kernel
example : (indexBits 4 [8,9,10] [true,true]).value=some 10 := by decide +kernel
example : (referenceEq 4 0 0).work=0 := by decide +kernel
example : (bitChecked 4 (some leaf) [leaf] 0 [[0],[0]]).value=some [[0],[0]] := by decide +kernel
