import PaidPrecontrols
namespace Universal233.Hard2PaidLocal.Controls
open RMAF CoreProgram BothBad
set_option maxRecDepth 10000
example : ((literalRun 1 [cut]).calls.map Call.budget)=[1] := by decide
example : ((literalRun 1 [cut,cut]).calls.map Call.budget)=[0] := by decide
example : (literalRun 0 [cut]).calls≠[] := by decide
example : ((literalRun 1 [zero]).calls.map Call.budget)=[0] := by decide
example : checked source source 1 (some [[999]])=some [[999]] := by decide
end Universal233.Hard2PaidLocal.Controls
