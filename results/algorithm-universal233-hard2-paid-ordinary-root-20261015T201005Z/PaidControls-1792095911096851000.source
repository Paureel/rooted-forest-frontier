import PaidValidity
import PaidPrecontrols
namespace Universal233.Hard2PaidLocal.Controls
open RMAF CoreProgram BothBad SourceCoverage
set_option maxRecDepth 10000

def tripleOutputs : List Output := outputs (.side []) source3 source3 [0] [1] 2

theorem literal_runtime (q : Nat) (outs : List Output) :
 runOutputs noOrd source source q outs=literalRun q outs := rfl

theorem generated_calls_paid :
 (runOutputs noOrd source3 source3 2 tripleOutputs).calls.isEmpty=false ∧
 (runOutputs noOrd source3 source3 2 tripleOutputs).calls.all (fun call=>call.budget==0)=true := by decide

theorem source_facts_planted :
 tripleOutputs.all (fun o=>partitionCheck (leaves source3) o.partition && pairwiseEmbeddings source3 o.partition &&
 (o.sourceCuts.length==2) && (o.partition.length==3))=true := by decide

theorem duplicates_paid : traceMass 2 1 (runOutputs noOrd source source 1 [cut,cut]).calls=1 ∧
 rawQMass 2 [cut,cut]=1 := by decide

theorem original_reject_retained : (runOutputs noOrd source source 1 [zero]).answer=none := by decide

def source5 : Tree := .node (.node (.node (.leaf 0) (.leaf 1)) (.leaf 2)) (.node (.leaf 3) (.leaf 4))
def target5 : Tree := .node (.node (.node (.leaf 0) (.leaf 2)) (.leaf 1)) (.node (.leaf 3) (.leaf 4))
theorem second_good_literal : restrictionAgrees source5 target5 [0,1,2]=false ∧ restrictionAgrees source5 target5 [3]=true := by decide

theorem second_good_runtime : edgeOutputs source5 target5 [0,1,2] [3] ([],[false]) 4=
 outputs (.side (PairGeometry.descendants target5 [false])) source5 target5 [3] [0,1,2] 4 := by decide

theorem first_good_priority : edgeOutputs source3 source3 [0] [1] ([],[false]) 2=
 outputs (.side (PairGeometry.descendants source3 [false])) source3 source3 [0] [1] 2 := by decide
end Universal233.Hard2PaidLocal.Controls
