    {
      "module": "MeterErase",
      "declaration": "frontier",
      "range": [
        47,
        59
      ],
      "code": "def frontier (ordinary : Ordinary) (T : Option Tree) (ss : List Tree) (q : Nat) : List Query :=\n if proper T ss && !agrees T ss (ss.map leaves) then\n  match T,ss with\n  | none,_ => []\n  | some t,[s] => [((t,s),q)]\n  | some t,_ => match overlap t ss with\n    | none => match jobs t ss with\n      | none => []\n      | some js => (meterSchedule (pairCallback ordinary) (fun _ _=>0) q js).queries\n    | some h => (branches t ss h q).flatMap fun io=>\n      let d:=io.2.sourceCuts.length\n      if _hd : 1\u2264d \u2227 d\u2264q then frontier ordinary T (replace ss io.1 io.2.partition) (q-d) else []\n else []",
      "context": [
        "import ForestTrace",
        "namespace GenericForest.FrontierWork",
        "open RMAF ForestState Universal233 Universal233.PaidQueries"
      ],
      "source": "research/rmaf/algorithm/universal233/ordinary_dispatch/full_source_counter_assembly_20261017T111531Z/build/MeterErase.lean",
      "source_sha256": "be275947eef30389acd38f5bf3dc0bbb9def545ce5b96756e02a2357fbee7f54",
      "object": "research/rmaf/algorithm/universal233/ordinary_dispatch/full_source_counter_assembly_20261017T111531Z/build/MeterErase.olean",
      "object_sha256": "262f7ac187d409390d08ab84b63ba97d6aa508d147f4cf7ed51304ebf9f21a87",
      "termination_interface": {
        "measure": "q",
        "required_proposition": "Under1<=d and d<=q, q-d<q; proof value omitted, no axiom."
      }
    },
