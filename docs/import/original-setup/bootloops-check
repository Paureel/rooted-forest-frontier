#!/bin/sh
set -eu
BOOTSCIENCE_SCRIPT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$BOOTSCIENCE_SCRIPT_ROOT/activate.sh"
cd "$BOOTSCIENCE_ROOT/bootloops"
if [ "$#" -eq 0 ]; then
    set -- --par 8
fi
if [ "${BOOTLOOPS_MONITOR_DISABLE:-0}" = "1" ]; then
    exec "$BOOTSCIENCE_ROOT/.venv/bin/python3" run_selftests.py "$@"
fi
exec "$BOOTSCIENCE_ROOT/.venv/bin/python3" "$BOOTSCIENCE_ROOT/dashboard/track.py" "$BOOTSCIENCE_ROOT/.venv/bin/python3" run_selftests.py "$@"
